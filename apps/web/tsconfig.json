{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "env.d.ts",
    /*
     * OG 配置是 .mjs（构建脚本用 node 直接跑），
     * 必须显式包含它的 .d.ts，否则 TS 会按 .mjs 推断成 {}，
     * 导致 og.title 之类全部报「属性不存在」。
     */
    "og.config.mjs",
    "og.config.d.mts"
  ],
  "exclude": ["node_modules", "dist"]
}