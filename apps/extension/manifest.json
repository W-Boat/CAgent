{
  "manifest_version": 3,
  "name": "CAgent 课表助手",
  "version": "2.0.0",
  "description": "只读提取社科大新本科教务「我的课表」可见课程表，供本人确认、个人导览与提醒。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://ut.ucass.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://campus.example.org/timetable*",
        "http://localhost:5173/timetable*",
        "http://127.0.0.1:5173/timetable*",
        "http://localhost:4173/timetable*",
        "http://127.0.0.1:4173/timetable*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CAgent 课表助手",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
