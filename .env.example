# ---------- 应用 ----------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
# 前端访问地址（用于 CORS 白名单）
WEB_ORIGIN=http://localhost:5173
SITE_ORIGIN=http://localhost:5173
VITE_SITE_ORIGIN=http://localhost:5173

# ---------- 数据库 ----------
# 为 Compose 设置自己的随机密码；DATABASE_URL 密码与它保持一致
DB_PASSWORD=
# 便携版 PostgreSQL（tools/setup-postgres.ps1 创建）
DATABASE_URL="postgresql://cagent:CHANGE_ME@127.0.0.1:5432/cagent?schema=public"

# ---------- 认证 ----------
# 生产环境务必替换：openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# 初始超级管理员（仅首次 seed 时使用）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=超级管理员

# ---------- 模型供应商（可选，留空则由后台管理页面配置）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=
GROQ_API_KEY=

# 本地 Ollama（可选）
OLLAMA_BASE_URL=http://localhost:11434

# ---------- 浏览器操控 ----------
# Playwright 是否以无头模式运行
BROWSER_HEADLESS=true
# 截图与录制产物目录
BROWSER_ARTIFACT_DIR=./storage/browser

# ---------- 其他 ----------
# 单个用户默认每日 token 配额（0 = 不限）
DEFAULT_DAILY_TOKEN_QUOTA=0
# 单次请求最大 token
DEFAULT_MAX_TOKENS=4096
# Optional WeRSS collector; generate private credentials before enabling.
WECHAT_COLLECTOR_URL=http://cagent-wechat:8001
WECHAT_COLLECTOR_USER=cagent
WECHAT_COLLECTOR_PASSWORD=
WERSS_SECRET_KEY=
CAGENT_NETWORK=cagent_default
